# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Gemini ─────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ── GCP / GKE (required for scripts/gke-up.sh) ───────────────────────────────
# Your GCP project ID — find it at console.cloud.google.com
GCP_PROJECT_ID=your-gcp-project-id
# Region for the cluster and Artifact Registry (us-central1 is cheapest for demos)
GCP_REGION=us-central1

# ── Internal service URLs (set automatically by docker-compose / Kubernetes) ──
# Override locally only if running services outside of Docker.
# AI_SERVICE_URL=http://localhost:3001
