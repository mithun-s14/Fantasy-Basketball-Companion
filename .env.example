# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Gemini ─────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ── GCP / GKE (required for scripts/gke-up.sh) ───────────────────────────────
# Your GCP project ID — find it at console.cloud.google.com
GCP_PROJECT_ID=your-gcp-project-id
# Region for the cluster and Artifact Registry (us-central1 is cheapest for demos)
GCP_REGION=us-central1

# ── Internal service URLs (set automatically by docker-compose / Kubernetes) ──
# Override locally only if running services outside of Docker.
# AI_SERVICE_URL=http://localhost:3001

# ── Coach agent (docs/agent/jev-agent-spec.md) ───────────────────────────────
# Vercel AI Gateway key — only needed to run the `jev` decision engine.
# Without it the cutoff guard blocks Jev and the fallback engine is used.
AI_GATEWAY_API_KEY=your-ai-gateway-key

# All optional — these are the defaults. Redis (`npm run flags:set`) overrides them.
# AGENT_MODE=off                       # on | off
# DECISION_ENGINE=rules                # jev | gemini | rules
# DECISION_ENGINE_ROUTE=               # per-capability override, inherits when empty
# DECISION_ENGINE_VERIFY=              # jev | gemini | rules | off
# DECISION_FALLBACK=rules              # gemini | rules
# DECISION_SHADOW=off                  # jev | gemini | rules | off
# JEV_CUTOFF=2026-09-25T00:00:00Z
# JEV_ALLOW_PAID=false                 # the only way to call Jev after the cutoff
# ROUTE_MIN_PROB=0.6
# VERIFY_MIN_PROB=0.7
# MAX_AGENT_STEPS=4
# AGENT_LOOP_TIMEOUT_MS=8000
# LOG_DECISION_STATE=false
